{
  "name": "@gnaws/core",
  "version": "0.1.0",
  "description": "Core library for AWS infrastructure discovery, graph building, and unused resource detection",
  "keywords": [
    "aws",
    "aws-sdk",
    "cloud",
    "infrastructure",
    "inventory",
    "graph",
    "unused-resources",
    "cost-optimization",
    "graphology",
    "gexf",
    "gephi"
  ],
  "type": "module",
  "scripts": {
    "lint": "npx eslint --fix .",
    "version": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s && git add CHANGELOG.md",
    "prepare": "[ -d .git ] && husky || true",
    "build": "tsdown",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:int": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "npm run build"
  },
  "author": "Fabio Dominio",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/FabioDominio/gnaws-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabioDominio/gnaws-core.git"
  },
  "bugs": {
    "url": "https://github.com/FabioDominio/gnaws-core/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
